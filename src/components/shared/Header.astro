---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import cv from '@cv';

const {
  basics: { siteLogo, siteName },
} = cv;

const [iconSize, logoSize] = [24, 30];
---

<header class="p-5">
  <nav class="flex justify-between items-center top-0 z-10" role="navigation">
    <h1 class="text-2xl text-gray-800 dark:text-gray-50 font-bold">
      <a href="/" class="inline-flex">
        <Image
          src={siteLogo}
          alt={siteName}
          height={logoSize}
          width={logoSize}
          loading="eager"
          title=""
        />
        <span class="ml-2">hectorolea</span>
        <span class="text-[#888a85]">dev</span>
      </a>
    </h1>
    <div class="flex items-center">
      <ul class="flex items-center space-x-6">
        <li>
          <button
            type="button"
            id="theme-selector"
            class="group"
            aria-pressed="false"
          >
            <span class="hidden dark:inline" aria-hidden="true"
              ><Icon name="sun" size={iconSize} /></span
            >
            <span class="dark:hidden" aria-hidden="true"
              ><Icon name="moon" size={iconSize} /></span
            >
          </button>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const themeSelector = document.getElementById('theme-selector');
  if (themeSelector) {
    // Update aria-pressed based on current theme
    const updateAriaPressed = () => {
      const isDark = document.documentElement.classList.contains('dark');
      themeSelector.setAttribute('aria-pressed', String(isDark));
    };

    updateAriaPressed();

    themeSelector.addEventListener('click', () => {
      localStorage.theme = localStorage.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark');
      updateAriaPressed();
    });
  }
</script>
