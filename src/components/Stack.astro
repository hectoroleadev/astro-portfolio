---
import cv from '@cv';
import { Image } from 'astro:assets';

const {
  stack: { sectionLabel, categories },
} = cv;
---

<section class='py-8 px-5' id='tech-stack'>
  <h2 class='text-2xl font-bold mb-6'>{sectionLabel}</h2>
  {
    categories.map(({ name, logos }) => (
      <div class='mb-4'>
        <h3 class='text-lg font-semibold mb-2'>{name}</h3>
        <div class='flex flex-wrap justify-start gap-4 md:gap-6'>
          {logos.map(({ src, alt }) => (
            <div
              class='flex items-center justify-center  p-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105'
              role='img'
              aria-label={alt}
              title={alt}
            >
              <img
                src={src}
                alt={alt}
                width='64'
                height='64'
                class='h-12 w-12 md:h-18 md:w-18 object-contain brightness-0 dark:invert'
                loading='lazy'
              />
            </div>
          ))}
        </div>
      </div>
    ))
  }
</section>
