---
import cvData from '@cv';
import type { CV } from '@/types/cv';

const cv = cvData as CV;
const {
  stack: { sectionLabel, categories },
} = cv;
// Logos live in public/ and are referenced by path, so they're plain <img>
// (public assets are not processed by Astro's <Image>).
---

<section class="py-8 px-5" id="tech-stack">
  <h2 class="text-2xl font-bold mb-6">{sectionLabel}</h2>
  <div class="space-y-4">
    {
      categories.map(({ name, logos }) => (
        <div class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-4">
          <h3 class="text-lg font-semibold shrink-0 sm:w-40 sm:pt-1.5">
            {name}
          </h3>
          <div class="flex flex-wrap gap-2">
            {logos.map(({ src, alt }) => (
              <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-md transition-colors duration-200">
                <img
                  src={src}
                  alt=""
                  width="64"
                  height="64"
                  class="h-5 w-5 object-contain brightness-0 dark:invert image-placeholder"
                  loading="lazy"
                  decoding="async"
                />
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200">
                  {alt}
                </span>
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll(
      '#tech-stack img.image-placeholder'
    );
    images.forEach((img) => {
      const image = img as HTMLImageElement;
      if (image.complete) {
        image.classList.remove('image-placeholder');
      } else {
        image.addEventListener('load', () => {
          image.classList.remove('image-placeholder');
        });
      }
    });
  });
</script>
