---
import cv from '@cv';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const {
  basics: { name, summary, label, avatar, resumePdf },
  connect: { socials },
} = cv;

const [iconSize, imageSize] = [30, 150];
---

<div class='flex flex-col md:flex-row md:items-center md:gap-8 lg:gap-12'>
  <!-- Avatar Section -->
  <div class='flex-shrink-0 mb-6 md:mb-0'>
    <div class='flex justify-center md:justify-start'>
      <Image
        src={avatar}
        alt={`${name} - ${label}`}
        height={imageSize}
        width={imageSize}
        class='size-32 md:size-40 lg:size-48 rounded-2xl md:rounded-3xl my-border transition-transform duration-300 hover:scale-105'
        loading='eager'
        fetchpriority='high'
      />
    </div>
  </div>

  <!-- Content Section -->
  <div class='flex-1 text-center md:text-left'>
    <h1 class='text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-2'>
      {name}
    </h1>
    <h2 class='text-2xl md:text-3xl lg:text-4xl text-gray-700 dark:text-gray-300 font-medium tracking-wide mb-6'>
      {label}
    </h2>
    
    <p class='text-base md:text-lg lg:text-xl text-gray-700 dark:text-gray-300 mb-6 leading-relaxed max-w-2xl mx-auto md:mx-0'>
      {summary}
    </p>

    <!-- Social Links & Resume -->
    <div class='flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4'>
      <div class='flex flex-wrap justify-center gap-2'>
        {
          socials.map(({ url, label, icon, network }) => (
            <a
              href={url}
              class='inline-flex items-center gap-2 px-4 py-2 my-border rounded-lg hover:scale-105 transition-all duration-200'
              target='_blank'
              rel='noopener noreferrer'
              aria-label={`Visit ${network} profile${label ? `: ${label}` : ''}`}
            >
              <Icon name={icon} size={iconSize} aria-hidden='true' />
              {label && <span class='text-sm'>{label}</span>}
            </a>
          ))
        }
      </div>
      <a
        class='inline-flex items-center gap-2 px-4 py-2 my-border rounded-lg hover:scale-105 transition-all duration-200'
        href={resumePdf}
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Download resume PDF'
      >
        <Icon name='download' size={iconSize} aria-hidden='true' />
        <span class='text-sm'>Download Resume</span>
      </a>
    </div>
  </div>
</div>

<style>
  .my-hover {
    @apply hover:bg-gray-950 hover:text-gray-50 hover:dark:bg-gray-50 hover:dark:text-gray-950;
  }

  .my-border {
    @apply border border-gray-950 dark:border-gray-50 transition-colors duration-300;
  }
  
  .my-border:hover {
    @apply transition-colors duration-300;
  }
</style>
