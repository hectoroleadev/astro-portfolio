---
import cvData from '@cv';
import type { CV } from '@/types/cv';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const cv = cvData as CV;
const {
  basics: { name, summary, label, avatar, resumePdf },
  connect: { socials },
} = cv;

const [iconSize, imageSize] = [30, 150];

function getSocialAriaLabel(
  network: string,
  labelText: string | undefined
): string {
  if (network === 'email') {
    return `Send me an email: ${labelText}`;
  }
  return `Visit my ${network} profile${labelText ? `: ${labelText}` : ''}`;
}
---

<div class="flex flex-col items-center text-center">
  <!-- Avatar Section -->
  <div class="mb-4">
    <Image
      id="profile-avatar"
      src={avatar}
      alt={`${name} - ${label}`}
      height={imageSize}
      width={imageSize}
      class="size-28 md:size-32 mx-auto rounded-full border border-gray-200 dark:border-gray-600 shadow-sm image-placeholder"
      loading="eager"
      fetchpriority="high"
      title={`${name} - ${label}`}
    />
  </div>

  <!-- Content Section -->
  <div class="w-full">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">
      {name}
    </h1>
    <h2
      class="text-xl md:text-2xl text-accent font-medium tracking-wide mb-6"
    >
      {label}
    </h2>

    <!-- Social Links -->
    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        {
          socials.map(({ url, label, icon, network }) => (
            <a
              href={url}
              class="inline-flex items-center gap-2 px-4 py-2 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105 group my-hover"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={getSocialAriaLabel(network, label)}
            >
              <Icon name={icon} size={iconSize} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>

    <p
      class="text-base md:text-lg text-gray-700 dark:text-gray-300 mb-8 leading-relaxed px-4 md:px-0 text-left max-w-prose mx-auto"
    >
      {summary}
    </p>

    <!-- Resume Download -->
    <div class="flex justify-center">
      <a
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105 group my-hover"
        href={resumePdf}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Download resume PDF"
      >
        <Icon name="download" size={iconSize} aria-hidden="true" />
        <span class="text-sm">Download Resume</span>
      </a>
    </div>
  </div>
</div>

<style>
  .my-hover {
    @apply hover:bg-gray-950 hover:text-gray-50 hover:dark:bg-gray-50 hover:dark:text-gray-950;
  }

  .my-border {
    @apply border border-gray-950 dark:border-gray-50 transition-colors duration-300;
  }

  .my-border:hover {
    @apply transition-colors duration-300;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const avatar = document.getElementById(
      'profile-avatar'
    ) as HTMLImageElement;
    if (avatar) {
      if (avatar.complete) {
        avatar.classList.remove('image-placeholder');
      } else {
        avatar.addEventListener('load', () => {
          avatar.classList.remove('image-placeholder');
        });
      }
    }
  });
</script>
