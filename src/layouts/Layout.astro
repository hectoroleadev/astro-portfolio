---
import Footer from '@/components/shared/Footer.astro';
import Header from '@/components/shared/Header.astro';
import '@fontsource-variable/source-code-pro';
import cv from '@cv';

interface Props {
  title: string;
  site: string;
  description: string;
  image: string;
}

const { title, site, description, image } = Astro.props;
const mode = import.meta.env.MODE;
const { basics } = cv;
const siteUrl = Astro.site || new URL(Astro.url.pathname, Astro.url.origin);
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='manifest' href='/manifest.json' />
    <link rel='icon' type='image/png' sizes='192x192' href='/maskable192.png' />
    <link rel='icon' type='image/png' sizes='96x96' href='/maskable96.png' />
    <link
      rel='apple-touch-icon'
      type='image/png'
      sizes='192x192'
      href='/maskable192.png'
    />
    <link
      rel='apple-touch-icon'
      type='image/png'
      sizes='96x96'
      href='/maskable96.png'
    />
    <!-- Preconnect to external domains for performance -->
    <link rel='preconnect' href='https://storage.hectorolea.dev' crossorigin />
    
    <meta name='generator' content={Astro.generator} />
    <meta name='author' content={basics.name} />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='keywords' content='full stack developer, devops, astro, tailwind, typescript' />
    
    <!-- Structured Data (JSON-LD) -->
    <script type='application/ld+json' set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: basics.name,
      jobTitle: basics.label,
      description: description,
      image: basics.avatar,
      url: siteUrl.toString(),
      sameAs: cv.connect.socials.map((social) => social.url),
      address: {
        '@type': 'PostalAddress',
        addressLocality: basics.location.city,
        addressCountry: basics.location.countryCode,
      },
    })} />

    <!-- Open Graph -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content={Astro.url} />
    <meta property='og:site_name' content={site} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={fullImageUrl} />

    <!-- Twitter -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:url' content={Astro.url} />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={fullImageUrl} />
  </head>
  <body>
    <Header />
    <main role='main'>
      <slot />
    </main>
    <Footer />
    <button
      id='scroll-to-top'
      class='fixed bottom-6 right-6 z-40 hidden p-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-full shadow-lg hover:bg-gray-800 dark:hover:bg-gray-200 transition-all duration-300 opacity-0 translate-y-4 focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-gray-400'
      aria-label='Scroll to top'
      title='Scroll to top'
    >
      <svg
        xmlns='http://www.w3.org/2000/svg'
        fill='none'
        viewBox='0 0 24 24'
        stroke-width='2'
        stroke='currentColor'
        class='w-6 h-6'
        aria-hidden='true'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          d='M4.5 15.75l7.5-7.5 7.5 7.5'
        />
      </svg>
    </button>
    <div id="notification" class="hidden fixed bottom-5 right-5 z-50 bg-gray-800 text-white p-4 rounded-lg shadow-lg" role="alert" aria-live="polite">
      <p>A new version is available!</p>
      <button id="refresh-button" class="mt-2 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition-colors duration-200" aria-label="Refresh page to update">Refresh</button>
    </div>
  </body>
</html>
<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 375;
    font-variation-settings:
      'wdth' 75,
      'wght' 375;
    @apply m-auto max-w-2xl bg-white text-gray-900 dark:bg-black dark:text-gray-50;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  #scroll-to-top.visible {
    @apply opacity-100 translate-y-0;
    display: block;
  }

  h1 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 400;
    font-variation-settings:
      'wdth' 75,
      'wght' 400;
  }

  h2 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 325;
    font-variation-settings:
      'wdth' 75,
      'wght' 325;
  }
</style>
<script is:inline>
  if (
    localStorage.theme === 'dark' ||
    (!('theme' in localStorage) &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>

<script is:inline>
  // Scroll to top button
  const scrollToTopButton = document.getElementById('scroll-to-top');
  if (scrollToTopButton) {
    const toggleScrollButton = () => {
      if (window.scrollY > 300) {
        scrollToTopButton.classList.add('visible');
      } else {
        scrollToTopButton.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', toggleScrollButton);
    
    scrollToTopButton.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<script is:inline define:vars={{ mode }}>
  if (mode === 'production') {
    addEventListener('load', () => {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('sw.js').then(registration => {
          navigator.serviceWorker.addEventListener('message', event => {
            if (event.data.type === 'NEW_VERSION') {
              const notification = document.getElementById('notification');
              notification.classList.remove('hidden');
              document.getElementById('refresh-button').addEventListener('click', () => {
                registration.waiting.postMessage({ type: 'SKIP_WAITING' });
                window.location.reload();
              });
            }
          });
        });
      }
    });
  }
</script>
