---
import Footer from '@/components/shared/Footer.astro';
import Header from '@/components/shared/Header.astro';
import '@fontsource-variable/source-code-pro';
import cvData from '@cv';
import type { CV } from '@/types/cv';

const cv = cvData as CV;

interface Props {
  title: string;
  site: string;
  description: string;
  image: string;
}

const { title, site, description, image } = Astro.props;
const mode = import.meta.env.MODE;
const { basics } = cv;
const siteUrl = Astro.site || new URL(Astro.url.pathname, Astro.url.origin);
const fullImageUrl = image.startsWith('http')
  ? image
  : new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Conservative CSP. 'unsafe-inline' is required by the inline theme/SW
         scripts and Tailwind's injected styles; storage.googleapis.com is the
         Workbox CDN imported by the service worker. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' https://storage.hectorolea.dev data:; script-src 'self' 'unsafe-inline' https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://storage.hectorolea.dev https://storage.googleapis.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" sizes="192x192" href="/maskable192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/maskable96.png" />
    <link
      rel="apple-touch-icon"
      type="image/png"
      sizes="192x192"
      href="/maskable192.png"
    />
    <link
      rel="apple-touch-icon"
      type="image/png"
      sizes="96x96"
      href="/maskable96.png"
    />
    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://storage.hectorolea.dev" crossorigin />

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={basics.name} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="full stack developer, devops, astro, tailwind, typescript"
    />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: basics.name,
        jobTitle: basics.label,
        description: description,
        image: basics.avatar,
        url: siteUrl.toString(),
        sameAs: cv.connect.socials.map((social) => social.url),
        address: {
          '@type': 'PostalAddress',
          addressLocality: basics.location.city,
          addressCountry: basics.location.countryCode,
        },
      })}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
  </head>
  <body>
    <Header />
    <main role="main" class="fade-in">
      <slot />
    </main>
    <Footer />
    <button
      id="scroll-to-top"
      class="fixed bottom-6 right-6 z-40 hidden p-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-full shadow-lg hover:bg-gray-800 dark:hover:bg-gray-200 transition-all duration-300 opacity-0 translate-y-4 focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-gray-400"
    >
      <span class="group tooltip-end" aria-label="Scroll to top">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
        </svg>
      </span>
    </button>
    <!-- PWA Update Notification -->
    <div
      id="new-version-toast"
      class="hidden fixed bottom-6 left-6 right-6 sm:right-auto z-50 p-4 rounded-lg shadow-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 flex items-center gap-4"
      role="alert"
      aria-live="assertive"
    >
      <p class="text-sm">A new version is available.</p>
      <div class="flex gap-2">
        <button
          id="pwa-refresh"
          class="px-4 py-1 text-sm font-semibold rounded-md border border-gray-200 dark:border-gray-700 hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors"
        >
          Refresh
        </button>
        <button
          id="pwa-close"
          class="p-1 hover:bg-gray-800 dark:hover:bg-gray-200 rounded-full"
        >
          <span class="group tooltip-end" aria-label="Close update notification">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </body>
</html>
<style is:global>
  :root {
    --accent: 37 99 235; /* blue-600 */
  }

  html.dark {
    --accent: 96 165 250; /* blue-400 — lighter for contrast on dark bg */
  }

  html {
    scroll-behavior: smooth;
    /* Safety net: absolutely-positioned decorations (tooltips) near the
       viewport edge must never create a horizontal scrollbar */
    overflow-x: clip;
  }

  /* Visible keyboard focus across interactive elements */
  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  body {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 375;
    font-variation-settings:
      'wdth' 75,
      'wght' 375;
    @apply m-auto max-w-2xl bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-50;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .fade-in {
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes shimmer {
    0% {
      background-color: #e5e7eb;
    } /* gray-200 */
    50% {
      background-color: #d1d5db;
    } /* gray-300 */
    100% {
      background-color: #e5e7eb;
    } /* gray-200 */
  }

  .image-placeholder {
    animation: shimmer 1.5s infinite;
    @apply bg-gray-200 dark:bg-gray-800;
  }

  #scroll-to-top.visible {
    @apply opacity-100 translate-y-0;
    display: block;
  }

  h1 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 400;
    font-variation-settings:
      'wdth' 75,
      'wght' 400;
  }

  h2 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 325;
    font-variation-settings:
      'wdth' 75,
      'wght' 325;
  }

  [data-tooltip] {
    position: relative;
  }

  [data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%; /* Above the element */
    left: 0%; /* To the left of the element */
    transform: none;
    padding: 0.3em 0.5em; /* Smaller padding */
    border-radius: 0.25em;
    background-color: rgba(51, 51, 51, 0.75);
    color: #fff;
    width: max-content;
    max-width: min(78vw, 12rem); /* long tooltips wrap instead of overflowing */
    /* display:none (not visibility) — a hidden tooltip must not take up
       overflow space, or it forces a horizontal scrollbar on small screens */
    display: none;
    opacity: 0;
    transition:
      opacity 0.2s,
      display 0.2s allow-discrete;
    margin-bottom: 0.25rem; /* Smaller space between element and tooltip */
    font-size: 0.85rem; /* Smaller font size */
    z-index: 999;
  }

  [data-tooltip]:hover::after,
  [data-tooltip]:focus-visible::after {
    display: block;
    opacity: 1;
  }

  @starting-style {
    [data-tooltip]:hover::after,
    [data-tooltip]:focus-visible::after {
      opacity: 0;
    }
  }

  /* For elements near the right viewport edge: grow the tooltip inward
     so it never creates horizontal overflow */
  .tooltip-end[data-tooltip]::after {
    left: auto;
    right: 0;
  }

  /* Respect users who prefer reduced motion: kill animations and transitions */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
<script is:inline>
  if (
    localStorage.theme === 'dark' ||
    (!('theme' in localStorage) &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>

<script is:inline>
  // Scroll to top button
  const scrollToTopButton = document.getElementById('scroll-to-top');
  if (scrollToTopButton) {
    const toggleScrollButton = () => {
      if (window.scrollY > 300) {
        scrollToTopButton.classList.add('visible');
      } else {
        scrollToTopButton.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', toggleScrollButton);

    scrollToTopButton.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const elementsWithAriaLabel = document.querySelectorAll('[aria-label]');
    elementsWithAriaLabel.forEach((element) => {
      const ariaLabel = element.getAttribute('aria-label');
      if (ariaLabel) {
        element.setAttribute('data-tooltip', ariaLabel);
      }
    });
  });
</script>

<script is:inline define:vars={{ mode }}>
  if (mode === 'production' && 'serviceWorker' in navigator) {
    const toast = document.getElementById('new-version-toast');
    const refreshButton = document.getElementById('pwa-refresh');
    const closeButton = document.getElementById('pwa-close');

    let newWorker;

    const showUpdateToast = (worker) => {
      newWorker = worker;
      toast.classList.remove('hidden');
    };

    closeButton.addEventListener('click', () => {
      toast.classList.add('hidden');
    });

    refreshButton.addEventListener('click', () => {
      if (newWorker) {
        newWorker.postMessage({ type: 'SKIP_WAITING' });
      }
    });

    navigator.serviceWorker.register('sw.js').then((reg) => {
      reg.addEventListener('updatefound', () => {
        const installingWorker = reg.installing;
        installingWorker.addEventListener('statechange', () => {
          if (
            installingWorker.state === 'installed' &&
            navigator.serviceWorker.controller
          ) {
            showUpdateToast(installingWorker);
          }
        });
      });
    });

    let refreshing = false;
    navigator.serviceWorker.addEventListener('controllerchange', () => {
      if (!refreshing) {
        window.location.reload();
        refreshing = true;
      }
    });
  }
</script>
