---
import Footer from '@/components/shared/Footer.astro';
import Header from '@/components/shared/Header.astro';
import '@fontsource-variable/source-code-pro';

interface Props {
  title: string;
  site: string;
  description: string;
  image: string;
}

const { title, site, description, image } = Astro.props;
const mode = import.meta.env.MODE;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='manifest' href='/manifest.json' />
    <link rel='icon' type='image/png' sizes='192x192' href='/maskable192.png' />
    <link rel='icon' type='image/png' sizes='96x96' href='/maskable96.png' />
    <link
      rel='apple-touch-icon'
      type='image/png'
      sizes='192x192'
      href='/maskable192.png'
    />
    <link
      rel='apple-touch-icon'
      type='image/png'
      sizes='96x96'
      href='/maskable96.png'
    />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta property='og:site_name' content={site} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={image} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <div id="notification" class="hidden fixed bottom-5 right-5 bg-gray-800 text-white p-4 rounded-lg shadow-lg">
      <p>A new version is available!</p>
      <button id="refresh-button" class="mt-2 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Refresh</button>
    </div>
  </body>
</html>
<style is:global>
  body {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 375;
    font-variation-settings:
      'wdth' 75,
      'wght' 375;
    @apply m-auto max-w-2xl bg-white text-gray-900 dark:bg-black dark:text-gray-50;
  }

  h1 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 400;
    font-variation-settings:
      'wdth' 75,
      'wght' 400;
  }

  h2 {
    font-family: 'Source Code Pro Variable', monospace;
    font-weight: 325;
    font-variation-settings:
      'wdth' 75,
      'wght' 325;
  }
</style>
<script is:inline>
  if (
    localStorage.theme === 'dark' ||
    (!('theme' in localStorage) &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>

<script is:inline define:vars={{ mode }}>
  if (mode === 'production') {
    addEventListener('load', () => {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('sw.js').then(registration => {
          navigator.serviceWorker.addEventListener('message', event => {
            if (event.data.type === 'NEW_VERSION') {
              const notification = document.getElementById('notification');
              notification.classList.remove('hidden');
              document.getElementById('refresh-button').addEventListener('click', () => {
                registration.waiting.postMessage({ type: 'SKIP_WAITING' });
                window.location.reload();
              });
            }
          });
        });
      }
    });
  }
</script>
