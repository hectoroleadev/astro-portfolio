---
import Hero from '@/components/Hero.astro';
import Stack from '@/components/Stack.astro';
import Experience from '@/components/Experience.astro';
import Layout from '@/layouts/Layout.astro';
import cv from '@cv';

const {
  basics: { siteName, name, label, siteOgLogo, summary },
} = cv;
---

<Layout
  title={`${name} - ${label}`}
  site={siteName}
  description={summary}
  image={siteOgLogo}
>
  <section
    id='hero'
    class='min-h-[75vh] place-content-center place-items-center px-5 animate-fade'
  >
    <Hero />
  </section>
  <section id='experience'>
    <Experience />
  </section>
  <section id='stack'>
    <Stack />
  </section>
</Layout>
